name: dockercompose5209125218663218594
services:
  foodorder.pedidos.presentation:
    build:
      context: C:\Users\robso\workspace\food-order-pedidos\FoodOrder.Pedidos
      dockerfile: src/FoodOrder.Pedidos.Presentation/Dockerfile
    depends_on:
      postgres:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ConnectionStrings__DefaultConnection: Host=postgres;Port=5432;Database=foodorder_pedidos_db;Username=postgres;Password=postgres
    image: foodorderpedidospresentation
    networks:
      foodorder-network: null
    ports:
      - mode: ingress
        target: 80
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\robso\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\robso\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  postgres:
    container_name: foodorder_postgres
    environment:
      POSTGRES_DB: foodorder_pedidos_db
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:16
    networks:
      foodorder-network: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql/data
        volume: {}
networks:
  foodorder-network:
    name: dockercompose5209125218663218594_foodorder-network
    driver: bridge
volumes:
  pgdata:
    name: dockercompose5209125218663218594_pgdata